# Copy this file to .env and fill it in. .env is git-ignored, so your login is never committed.

# The portal.
URJA_BASE_URL=https://urja-ops.flockenergy.tech

# The test login from the assignment.
URJA_EMAIL=your-email-here
URJA_PASSWORD=your-password-here

# Optional settings (these are the defaults).
# How long the cached meter and transformer data counts as fresh, in seconds.
CATALOG_TTL_SECONDS=600
# Log in again this many seconds before the one-hour session runs out.
SESSION_MARGIN_SECONDS=300
# How long to wait for the portal on one request, in seconds.
REQUEST_TIMEOUT_SECONDS=20

  "info": {
    "description": "\nA clean, read-only API in front of the legacy **Urja Meter Ops** portal.\n\n* Meter and transformer data come from the portal's bulk export and are cached (see `/health`).\n* Readings are fetched live from the portal on every request.\n* Timestamps are ISO 8601. The portal sends no timezone; **IST (+05:30) is assumed**.\n* Errors always look like `{\"error\": \"<code>\", \"message\": \"<text>\"}`.\n",
    "title": "Urja Meter API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Reports state only; it never calls the portal.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service health",
        "tags": [
          "ops"
        ]
      }
    },
    "/hierarchy": {
      "get": {
        "description": "Zone, circle, division, subdivision, substation, feeder, transformer. Codes are only unique\nwithin their parent, so every node carries a full `path` that is unique.",
        "operationId": "hierarchy_hierarchy_get",
        "parameters": [
          {
            "description": "How many levels to return (1 = zones only).",
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "default": 7,
              "description": "How many levels to return (1 = zones only).",
              "maximum": 7,
              "minimum": 1,
              "title": "Depth",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HierarchyNode"
                  },
                  "title": "Response Hierarchy Hierarchy Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unknown meter, transformer or route."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "A parameter is missing or invalid."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The portal rejected us or answered in an unexpected way."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "The portal could not be reached."
          }
        },
        "summary": "The network as a tree",
        "tags": [
          "network"
        ]
      }
    },
    "/meters": {
      "get": {
        "operationId": "list_meters_meters_get",
        "parameters": [
          {
            "description": "Text in the meter id or serial number (ignores case).",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Text in the meter id or serial number (ignores case).",
              "title": "Q"
            }
          },
          {
            "description": "Installed, Faulty or Decommissioned.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Installed, Faulty or Decommissioned.",
              "title": "Status"
            }
          },
          {
            "description": "Manufacturer, e.g. HPL.",
            "in": "query",
            "name": "make",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Manufacturer, e.g. HPL.",
              "title": "Make"
            }
          },
          {
            "description": "'single' or 'three'.",
            "in": "query",
            "name": "phase",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "'single' or 'three'.",
              "title": "Phase"
            }
          },
          {
            "description": "'legacy' or 'v2'.",
            "in": "query",
            "name": "build",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "'legacy' or 'v2'.",
              "title": "Build"
            }
          },
          {
